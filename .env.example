# Copy to .env and fill in. Never commit .env.
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Local dev: sqlite:///./taxease.db
# Production (Supabase session pooler, IPv4-safe):
# postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./taxease.db

# openssl rand -hex 32  (must equal JWT_SECRET in frontend/.env.local)
SECRET_KEY=

# Optional: enables POST /api/financials/extract
GEMINI_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Files: local disk by default. Set both to store uploads in a private Supabase Storage bucket instead.
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=taxease-files
